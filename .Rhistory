ll = function(x,n,y){
log(choose(n,n*y)) + n*y*log(x) + n*(1-y)*log(1-x)
}
ll(0.5,n,y)
n = 5
y = 2
ll = function(x,n,y){
log(choose(n,n*y)) + n*y*log(x) + n*(1-y)*log(1-x)
}
ll(0.5,n,y)
n
y
n = 5
y = 0.2
ll = function(x,n,y){
log(choose(n,n*y)) + n*y*log(x) + n*(1-y)*log(1-x)
}
ll(0.5,n,y)
derivative(ll,var=c(x=0.5),n=5,y=0.2)
?D
library(Deriv)
D(ll,var=c(x=0.5),n=5,y=0.2)
?D
deriv(ll,'x',n=5,y=0.2)
deriv(ll,'x')
?deriv
?Deriv
Deriv(ll,'x')
Sco = function(x,n,y){
n * (y/x - (1 - y)/(1 - x))
}
Sco(ll,'x')
Deriv(Sco,'x')
Sco = function(x,n,y){
n * (y/x - (1 - y)/(1 - x))
}
Sco2 = function(x,n,y){
n * (y-x)/(x*(1-x))
}
Sco(0.5,10,0.2)
Sco2(0.5,10,0.2)
